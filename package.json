{
  "name": "clocktower-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start --locale en --port 3000",
    "start:es": "docusaurus start --locale es --port 3001",
    "start:i18n": "concurrently -k -n en,es -c blue,magenta \"DOCUSAURUS_I18N_DUAL_DEV=true npm run start\" \"DOCUSAURUS_I18N_DUAL_DEV=true npm run start:es\"",
    "preview": "docusaurus build && docusaurus serve",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids"
  },
  "dependencies": {
