    "svgo": "^3.3.3",
    "undici": "^7.24.0",
    "path-to-regexp": "^1.8.0",
    "picomatch": ">=2.3.2",
    "brace-expansion": ">=5.0.6",
    "fast-uri": ">=3.1.2",
    "@babel/plugin-transform-modules-systemjs": ">=7.29.4",
    "webpack-dev-server": ">=5.2.4",
    "uuid": ">=14.0.0"
